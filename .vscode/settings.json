{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "jupyter.kernels.filter": [
        {
            "path": "${workspaceFolder}/.venv/bin/python",
            "type": "pythonEnvironment"
        }
    ],
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true
    }
}
